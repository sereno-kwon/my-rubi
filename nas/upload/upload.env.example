# 이 파일을 upload.env 로 이름을 바꿔 값을 채움. upload.env 는 저장소에 올리지 않음

# Claude API 키 (console.anthropic.com → API Keys). 초안 만들기에 씀
ANTHROPIC_API_KEY=
# 초안을 쓰는 모델. 비용을 줄이려면 claude-haiku-5-5
CLAUDE_MODEL=claude-sonnet-5-5

# 포털 Apps Script 웹앱 주소 (포털 config.js 의 API_URL 과 같은 값). 직원 로그인 확인에 씀
PORTAL_API_URL=https://script.google.com/macros/s/AKfycbypQe4DIULfFv2JllxmXAgMFthIm-PRCSEwkM9kSQGCfOxJ7yn4Qp0TxwwJO3lppvYG/exec
ALLOWED_ORIGIN=https://my.rubiworkshop.com

# 엑셀 재고 수량에 넣을 이카운트 창고
MAIN_WH=RLD

# 아임웹 사이트 주소 (토큰이 어느 사이트 것인지 알아보는 데 씀)
SUPPLY_DOMAIN=rubisupply.com
WORKSHOP_DOMAIN=rubiworkshop.com

# 아임웹 액세스 토큰은 ecount-sync 폴더에서 자동으로 찾음 (읽기만 하고 갱신하지 않음)
# 자동으로 못 찾을 때만 직접 적음 (만료되면 다시 적어야 해서 권하지 않음)
IMWEB_TOKEN_SUPPLY=
IMWEB_TOKEN_WORKSHOP=

# v6 아코디언(루비워크샵) 끝의 연결 주소
CONSULT_URL=https://ai.rubiworkshop.com/
WARRANTY_URL=https://rubisupply.com/warranty
