# 이 파일을 stock.env 로 이름을 바꿔 값을 채움. stock.env 는 저장소에 올리지 않음
# (맥에서 점으로 시작하는 파일은 숨겨져 올리기 번거로워서 .env 대신 stock.env 를 씀)

# 이카운트 OpenAPI (이카운트 → 자기설정 → 정보관리 → API인증키)
# 가능하면 ecount-sync 와 다른 ERP 사용자 ID로 인증키를 따로 받는 것을 권장 (README 참고)
ECOUNT_COM_CODE=
ECOUNT_USER_ID=
ECOUNT_API_KEY=
# 회사 존 코드를 알면 적어 둠 (ecount-sync 설정이나 로그에 있음, 예: CC). 비워두면 처음 한 번 조회
ECOUNT_ZONE=

# 맨 위에 크게 보여줄 창고 (채널 재고 동기화 기준)
MAIN_WH=RLD

# 포털 Apps Script 웹앱 주소 (포털 config.js 의 API_URL 과 같은 값). 직원 로그인 확인에 씀
PORTAL_API_URL=https://script.google.com/macros/s/AKfycbypQe4DIULfFv2JllxmXAgMFthIm-PRCSEwkM9kSQGCfOxJ7yn4Qp0TxwwJO3lppvYG/exec
ALLOWED_ORIGIN=https://my.rubiworkshop.com

# 하루 이카운트 호출 상한 (이카운트 하루 한도 5000 중 이 서비스가 쓸 몫)
DAILY_LIMIT=1000
# 매일 이 시각(한국 시간) 이후 품목 목록을 새로 받음
CATALOG_HOUR=7
